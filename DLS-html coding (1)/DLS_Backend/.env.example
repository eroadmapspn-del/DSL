# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origins for CORS (comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5500,http://localhost:8080,http://127.0.0.1:5500,http://127.0.0.1:8080,null

# JWT Secret for Auth
JWT_SECRET=dls_beautybasket_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL / Custom SQL connector)
# When you provide the database connector, set USE_DATABASE=true and provide DATABASE_URL
USE_DATABASE=false
DATABASE_URL=postgresql://postgres:password@localhost:5432/dls_beautybasket

# File Upload / Storage Path
UPLOAD_DIR=./uploads
